# This file contains environment variables that will be injected into the Docker services.
# It's crucial for secure credential management in deployment.
# For production, consider Docker Secrets or a dedicated secrets management system.

# Example: A configuration value for the agent
AGENT_CONFIG_VALUE="This is a secure configuration value for the agent."

# Example: An API key (placeholder, not used by default in this prototype)
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
# MY_TOOL_API_KEY="sk_mytool_xyz123abc"

# Nginx related settings
NGINX_HOST_PORT=8080
NGINX_SERVER_NAME="localhost"
NGINX_UPSTREAM_HOST="agent_worker" # This would be the service name of the agent if it had an HTTP endpoint
NGINX_UPSTREAM_PORT=8000 # Example port if agent had an HTTP API
